# AWS Credentials & Configuration for Terraform
# Usage:
#   Bash/Linux/macOS:
#     source .env
#   PowerShell (Windows):
#     Get-Content .env | Where-Object { $_ -match '^([^#][^=]+)=(.*)$' } | ForEach-Object { [System.Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim(), "Process") }

AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1
# AWS_SESSION_TOKEN=your_session_token_if_using_temporary_credentials
